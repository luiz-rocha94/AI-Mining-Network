{
  "name": "invoice-extractor",
  "version": "1.0.0",
  "contentHash": "sha256:e7b56e1e8d17330cb8241fd8055540ccc3aa7405908aaa03fa75304f5583afa0",
  "skillFile": "SKILL.md",
  "inputSchema": {
    "type": "object",
    "properties": {
      "invoiceId": { "type": "string", "description": "Stable identifier for the invoice document being processed." },
      "documentText": { "type": "string", "description": "Text extracted from the invoice PDF or source document." }
    },
    "required": ["invoiceId", "documentText"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "invoiceId": { "type": "string", "description": "Identifier carried through from the input document." },
      "supplier": { "type": "string", "description": "Name of the supplier that issued the invoice." },
      "invoiceDate": { "type": "string", "format": "date", "description": "Invoice issue date in ISO 8601 YYYY-MM-DD format." },
      "totalAmount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$", "description": "Invoice total as a decimal string with up to two fractional digits." },
      "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "Three-letter ISO 4217 currency code." }
    },
    "required": ["invoiceId", "supplier", "invoiceDate", "totalAmount", "currency"],
    "additionalProperties": false
  },
  "requiredModels": [],
  "allowedTools": ["ollama.chat"],
  "verificationStrategy": "per-document",
  "requirements": {
    "cpuCores": 1,
    "ramBytes": 2147483648,
    "vramBytes": 0,
    "gpuRequired": false,
    "networkAccess": false,
    "timeoutSeconds": 3600
  },
  "publicBenchmarkIds": []
}
