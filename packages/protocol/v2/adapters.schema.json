{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mining-network.example/protocol/v2/adapters.schema.json",
  "title": "AI Mining Network adapter contract descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": "2" },
    "adapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "interface": {
      "enum": [
        "ComputeBackend",
        "PeerTransport",
        "PublicMetadataStore",
        "ArtifactStore",
        "RandomnessSource",
        "AttestationPublisher",
        "SettlementBackend"
      ]
    },
    "contractVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "implementation": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "requestSchema": { "type": "string", "minLength": 1 },
          "responseSchema": { "type": "string", "minLength": 1 },
          "idempotency": { "enum": ["required", "optional", "not-applicable"] },
          "retryableErrors": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "requestSchema", "responseSchema", "idempotency", "retryableErrors"]
      }
    },
    "productionReady": { "type": "boolean" },
    "trustNotes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["protocolVersion", "adapterId", "interface", "contractVersion", "implementation", "operations", "productionReady", "trustNotes"]
}
